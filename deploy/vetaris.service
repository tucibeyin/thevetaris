[Unit]
Description=Vetaris E-Commerce Python Server
After=network.target postgresql.service
Requires=postgresql.service

[Service]
# VPS'teki kullanıcı (deploy sırasında proje dizininin sahibi)
User=tucibeyin
Group=tucibeyin

# Projenin bulunduğu dizin
WorkingDirectory=/var/www/thevetaris.com

# Python sunucusunu başlatma komutu (venv içindeki python)
ExecStart=/var/www/thevetaris.com/venv/bin/python3 src/server.py

# Çökme durumunda otomatik yeniden başlat
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
